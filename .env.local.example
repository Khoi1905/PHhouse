NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NHẠY CẢM — bỏ qua toàn bộ RLS. CHỈ dùng trong Server Action (lib/supabase/admin.ts),
# KHÔNG BAO GIỜ thêm prefix NEXT_PUBLIC_, không bao giờ import vào Client Component.
# Lấy ở Supabase Dashboard → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
